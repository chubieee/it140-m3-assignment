
# IT 140 Module Three Assignment
# Paycheck Calculator Pseudocode

START paycheck_calculator

    GET hours_worked

    IF hours_worked <= 40
        SET weekly_pay = hours_worked * 20
    ELSE
        SET overtime_hours = hours_worked - 40
        SET overtime_pay = overtime_hours * 30
        SET weekly_pay = (40 * 20) + overtime_pay
    ENDIF

    PUT weekly_pay

END paycheck_calculator

